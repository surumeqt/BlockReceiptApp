{
  "expo": {
    "name": "BlockReceiptApp",
    "slug": "BlockReceiptApp",
    "version": "1.0.1",
    "orientation": "portrait",
    "scheme": "blockreceiptapp",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.kenbonzaiii.BlockReceiptApp"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bb6b3a36-3d04-4b5d-b3dc-345b5afbf08d"
      }
    },
    "owner": "kenbonzaiii",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/bb6b3a36-3d04-4b5d-b3dc-345b5afbf08d"
    }
  }
}
